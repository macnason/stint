{
  "name": "@macworks/stint-cli",
  "version": "1.0.0-next.3",
  "private": false,
  "type": "module",
  "description": "Authoring and import tooling for Stint career timelines.",
  "keywords": [
    "stint",
    "cli",
    "timeline",
    "career",
    "resume",
    "linkedin"
  ],
  "license": "MIT",
  "author": "Mac Nason <mac@macnason.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macnason/stint.git",
    "directory": "packages/stint-cli"
  },
  "homepage": "https://github.com/macnason/stint#readme",
  "bugs": {
    "url": "https://github.com/macnason/stint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "stint": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./guide": {
      "types": "./dist/agent-guide.d.ts",
      "import": "./dist/agent-guide.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js && cd ../.. && node scripts/build-document-engine.mjs",
    "test": "vitest run --config ../../vitest.workspace.ts packages/stint-cli/test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@macworks/stint": "1.0.0-next.3",
    "csv-parse": "^7.0.1",
    "puppeteer-core": "25.4.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0"
  }
}
