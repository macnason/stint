{
  "name": "@macnason/stint-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "stint": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run --config ../../vitest.workspace.ts packages/stint-cli/test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@macnason/stint": "0.0.0",
    "csv-parse": "^7.0.1",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0"
  }
}
